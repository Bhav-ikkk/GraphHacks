# FalkorDB is required for product reviews. Without a live graph, the engine
# fails closed (INSUFFICIENT_EVIDENCE) instead of inventing a decision.
# EDL_ALLOW_MEMORY_GRAPH=1 is only for automated tests. Do not set it for demos.

FALKORDB_HOST=13.236.193.238
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=edl
# EDL_ALLOW_MEMORY_GRAPH=

# --- LLM (optional) ---
# Google AI Studio: https://aistudio.google.com/apikey
# Leave PROVIDER=gemini and the base URL as below; paste your key.
SYZYGY_LLM_PROVIDER=gemini
SYZYGY_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SYZYGY_LLM_MODEL=gemini-3.8-flash
SYZYGY_LLM_API_KEY=
# Or set GEMINI_API_KEY= instead of SYZYGY_LLM_API_KEY.

# OpenAI-compatible alternative (OpenAI / OpenRouter / Groq / Ollama):
# SYZYGY_LLM_PROVIDER=openai
# SYZYGY_LLM_BASE_URL=https://api.openai.com/v1
# SYZYGY_LLM_MODEL=gpt-4o-mini
# SYZYGY_LLM_API_KEY=

# --- Live CI (optional) ---
# When set, Syzygy reads the latest GitHub Actions run into the same ci{}
# contract used by syzygy.evidence.yaml (live run wins when it has a result).
# GITHUB_TOKEN=
# GH_TOKEN=
