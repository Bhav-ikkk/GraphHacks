# FalkorDB is required for product reviews. Without a live graph, the engine
# fails closed (INSUFFICIENT_EVIDENCE) instead of inventing a decision.
# EDL_ALLOW_MEMORY_GRAPH=1 is only for automated tests. Do not set it for demos.

FALKORDB_HOST=13.236.193.238
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=edl
# EDL_ALLOW_MEMORY_GRAPH=

# --- LLM (optional) ---
# Google AI Studio: https://aistudio.google.com/apikey
# Leave PROVIDER=gemini and the base URL as below; paste your key.
SYZYGY_LLM_PROVIDER=gemini
SYZYGY_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SYZYGY_LLM_MODEL=gemini-3.8-flash
SYZYGY_LLM_API_KEY=
# Or set GEMINI_API_KEY= instead of SYZYGY_LLM_API_KEY.

# OpenAI-compatible alternative (OpenAI / OpenRouter / Groq / Ollama):
# SYZYGY_LLM_PROVIDER=openai
# SYZYGY_LLM_BASE_URL=https://api.openai.com/v1
# SYZYGY_LLM_MODEL=gpt-4o-mini
# SYZYGY_LLM_API_KEY=

# --- GitHub OAuth App (UI "Connect GitHub") ---
# Create at https://github.com/settings/developers → OAuth Apps
# Homepage URL + Authorization callback URL must match REDIRECT_URI exactly.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/
# GITHUB_OAUTH_SCOPES=repo read:user
# SYZYGY_SESSION_SECRET=change-me-to-a-long-random-string

# --- Live CI + PR comments (optional PAT fallback) ---
# When set, Syzygy reads the latest GitHub Actions run into the ci{} contract
# (live run wins when it has a result). OAuth session token is preferred for PR posts.
# GITHUB_TOKEN=
# GH_TOKEN=

# --- Owner notifications (optional) ---
# Drafts always write to logs/notifications/. SMTP send is optional.
# SYZYGY_NOTIFY_TO=you@example.com
# SYZYGY_SMTP_HOST=
# SYZYGY_SMTP_PORT=587
# SYZYGY_SMTP_USER=
# SYZYGY_SMTP_PASSWORD=
# SYZYGY_SMTP_FROM=
# SYZYGY_SMTP_TLS=1
