# FalkorDB database connection used by the Python client.
# This is not the browser. The browser login is:
#   http://13.236.193.238:3000/login
# Port 3000 only serves that website. The database port is separate, usually 6379.
# Leave the username empty. Put the password you create on the next line.
# FalkorDB Cloud shows the database host, port, and password on the instance page.
# Copy those three. Do not put the browser port (3000) in FALKORDB_PORT.

FALKORDB_HOST=13.236.193.238
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
